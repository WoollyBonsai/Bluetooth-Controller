<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnInit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Broadcast" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:text="Disconnected"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spinnerMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:entries="@array/mode_array" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Mode 1: Trackpad Only -->
        <LinearLayout
            android:id="@+id/layoutTrackpadOnly"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:id="@+id/touchArea1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#222" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLeftClick1"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:text="Left" />

                <Button
                    android:id="@+id/btnMiddleClick1"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:text="Mid" />

                <Button
                    android:id="@+id/btnRightClick1"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:text="Right" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mode 2: Trackpad + Keyboard -->
        <LinearLayout
            android:id="@+id/layoutTrackpadKeyboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:id="@+id/touchArea2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#333" />
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLeftClick2"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Left" />

                <Button
                    android:id="@+id/btnMiddleClick2"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Mid" />

                <Button
                    android:id="@+id/btnRightClick2"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Right" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">

                <EditText
                    android:id="@+id/etImmediateSend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Immediate typing..." />

                <Button
                    android:id="@+id/btnSpecialKeys"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Special Keys" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">

                <EditText
                    android:id="@+id/etStringSend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Type string and send..." />

                <Button
                    android:id="@+id/btnSendString"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send" />

                <Button
                    android:id="@+id/btnClipboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clipboard" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mode 3: Thinkpad Style -->
        <FrameLayout
            android:id="@+id/layoutThinkpad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#2a2a2a">
            
            <View
                android:id="@+id/touchArea3"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            
            <!-- Dynamically populated in Kotlin -->
        </FrameLayout>

        <!-- Mode 4: Multimedia Control -->
        <LinearLayout
            android:id="@+id/layoutMultimedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:background="#2a2a2a"
            android:padding="16dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Media Controls"
                android:textColor="#FFF"
                android:textSize="20sp"
                android:layout_marginBottom="16dp"/>

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="4"
                android:useDefaultMargins="true"
                android:alignmentMode="alignBounds">

                <!-- Row 1: Volume -->
                <Button android:id="@+id/btnVolDown" android:text="Vol -" />
                <Button android:id="@+id/btnMute" android:text="Mute" />
                <Button android:id="@+id/btnVolUp" android:text="Vol +" />

                <!-- Row 2: Media -->
                <Button android:id="@+id/btnPrevTrack" android:text="Prev" />
                <Button android:id="@+id/btnPlayPause" android:text="Play/Pause" />
                <Button android:id="@+id/btnNextTrack" android:text="Next" />
                
                <!-- Row 3: Brightness -->
                <Button android:id="@+id/btnBrightDown" android:text="Bright -" />
                <Space android:layout_width="50dp" />
                <Button android:id="@+id/btnBrightUp" android:text="Bright +" />
                
                <!-- Row 4: Display Mode -->
                <Button android:id="@+id/btnDisplayMode" android:layout_columnSpan="3" android:layout_gravity="fill_horizontal" android:text="Toggle Display (Win+P)" />
            </GridLayout>
        </LinearLayout>

        <!-- Mode 5: Presentation Mode -->
        <LinearLayout
            android:id="@+id/layoutPresentation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#2a2a2a">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="horizontal">
                
                <Button
                    android:id="@+id/btnF5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="F5 (Start)" />
                    
                <Button
                    android:id="@+id/btnEsc"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Esc (Stop)" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pointer Area"
                android:textAlignment="center"
                android:textColor="#FFF"
                android:padding="8dp"/>
                
            <View
                android:id="@+id/touchAreaPresentation"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#1a1a1a" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPrevSlide"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="&lt; Prev"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/btnNextSlide"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Next &gt;"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
